# EdgeLog Trader Agent -- local configuration template.
#
# Copy this file to `.env` in this same directory and fill in your own
# values. `.env` is gitignored and must NEVER be committed. Nothing in this
# file is read by, sent to, or stored in the EdgeLog cloud server -- this
# agent runs entirely on your own machine.

# Your TopstepX/ProjectX username (the one you log into topstepx.com with).
TOPSTEPX_USERNAME=

# Your TopstepX API key, generated from the TopstepX platform's API
# settings. Treat this exactly like a password: never share it, never
# paste it into a chat, GitHub issue, or PR. Rotate it if you ever suspect
# it leaked.
TOPSTEPX_API_KEY=

# Optional: once you've run the agent once and seen your real account list
# in the logs (see `list-accounts` in the README), pin the specific
# account ID you want the agent to treat as your Practice account here.
# This overrides the built-in Practice-detection heuristic -- do this
# before relying on the agent for anything, so there is no ambiguity about
# which account it is looking at.
TOPSTEPX_PRACTICE_ACCOUNT_ID=

# Futures root symbol to resolve and watch. ST0 only needs MNQ.
TOPSTEPX_SYMBOL=MNQ

# Base URLs. These match the publicly documented ProjectX Gateway API for
# TopstepX as of this writing -- override only if TopstepX/ProjectX
# publishes different values for your account.
TOPSTEPX_API_BASE_URL=https://api.topstepx.com
TOPSTEPX_RTC_BASE_URL=https://rtc.topstepx.com

# How long (seconds) market data can go without an update before the agent
# marks itself stale and reports an unhealthy status.
TOPSTEPX_STALE_AFTER_SECONDS=15
