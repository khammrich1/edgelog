# Environment
ENVIRONMENT=development

# Database
DATABASE_URL=postgresql+asyncpg://edgelog:password@localhost:5432/edgelog_dev

# Security
SECRET_KEY=your-secret-key-here-generate-with-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS - JSON array format
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Cookie settings
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=localhost

# AI screenshot trade capture (optional). Leave blank to disable the
# screenshot-upload feature -- it falls back to a 503 the frontend handles
# gracefully, and manual trade entry still works.
ANTHROPIC_API_KEY=
