# EdgeLog backend environment configuration (VS1)

# PostgreSQL connection used by SQLAlchemy (async driver)
DATABASE_URL=postgresql+asyncpg://edgelog:edgelog@localhost:5432/edgelog

# JWT signing secret - generate a long random value for real environments
JWT_SECRET=change-me-to-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Cookie security - set to true behind HTTPS in production
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
